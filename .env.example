ENVIRONMENT=development
DEV_AUTH=true
# Generate locally; 32+ random characters. Never use development identity on a shared server.
DEV_AUTH_SECRET=REPLACE_WITH_RANDOM_LOCAL_SECRET
DEV_EMAILS=planner@example.test,supervisor@example.test
DATABASE_URL=postgresql+psycopg://constructpm_app:PASSWORD@127.0.0.1:55432/constructpm
MIGRATION_DATABASE_URL=postgresql+psycopg://postgres:PASSWORD@127.0.0.1:55432/constructpm
# Production: ENVIRONMENT=production, DEV_AUTH=false, HTTPS issuer/JWKS required.
OIDC_ISSUER=
OIDC_AUDIENCE=constructpm-api
OIDC_JWKS_URL=
VITE_API_URL=http://127.0.0.1:8000
